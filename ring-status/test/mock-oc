#!/bin/bash
# mock-oc — Simulates 'oc' CLI responses for testing ring-status.sh
#
# Cluster personas (set via --context):
#   Ring 1 — all healthy, CSV v1.16.0
#     kflux-fedora-01   fully healthy
#     stone-prod-p01    fully healthy
#     kflux-osp-p01     fully healthy
#
#   Ring 2 — mixed, CSV v1.15.2 (drift vs ring 1)
#     stone-prod-p02    healthy but older CSV
#     kflux-rhel-p01    2 unhealthy pods
#     kflux-ocp-p01     events controller not ready
#
#   Ring 3 — includes unreachable
#     stone-prd-rh01    healthy, CSV v1.15.2
#     kflux-prd-rh02    UNREACHABLE (simulate timeout)
#     kflux-prd-rh03    healthy, CSV v1.15.2
#
# When no --context is given, behaves as kflux-fedora-01 (default).

set -euo pipefail

CONTEXT=""
ARGS=("$@")

# Extract --context value from args
i=0
while [[ $i -lt ${#ARGS[@]} ]]; do
  if [[ "${ARGS[$i]}" == "--context" ]]; then
    CONTEXT="${ARGS[$((i+1))]:-}"
    break
  fi
  i=$((i + 1))
done

# Default persona
[[ -z "$CONTEXT" ]] && CONTEXT="kflux-fedora-01"

# ── Unreachable cluster ─────────────────────────────────────────────────────
if [[ "$CONTEXT" == "kflux-prd-rh02" ]]; then
  exit 1
fi

# ── Cluster info (connectivity check) ──────────────────────────────────────
if [[ "$*" == *"cluster-info"* ]]; then
  echo "Kubernetes control plane is running at https://api.${CONTEXT}.example.com:6443"
  exit 0
fi

# ── Current context ────────────────────────────────────────────────────────
if [[ "$*" == *"config current-context"* ]]; then
  echo "$CONTEXT"
  exit 0
fi

# ── Per-cluster response data ──────────────────────────────────────────────
RING1_CSV="openshift-pipelines-operator-rh.v1.16.0"
RING2_CSV="openshift-pipelines-operator-rh.v1.15.2"
RING3_CSV="openshift-pipelines-operator-rh.v1.15.2"

CATSRC_SHA_RING1="sha256:aabbccdd11223344556677889900aabbccdd11223344556677889900aabb1111"
CATSRC_SHA_RING2="sha256:aabbccdd11223344556677889900aabbccdd11223344556677889900aabb2222"
CATSRC_SHA_RING3="sha256:aabbccdd11223344556677889900aabbccdd11223344556677889900aabb2222"

PAC_IMAGE_RING1="registry.redhat.io/pipelines/pac-controller@sha256:ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff001111"
PAC_IMAGE_RING2="registry.redhat.io/pipelines/pac-controller@sha256:ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff002222"
PAC_IMAGE_RING3="registry.redhat.io/pipelines/pac-controller@sha256:ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff002222"

case "$CONTEXT" in
  kflux-fedora-01|stone-prod-p01|kflux-osp-p01)
    CSV="$RING1_CSV"; CATSRC_SHA="$CATSRC_SHA_RING1"; PAC_IMAGE="$PAC_IMAGE_RING1" ;;
  stone-prod-p02|kflux-rhel-p01|kflux-ocp-p01)
    CSV="$RING2_CSV"; CATSRC_SHA="$CATSRC_SHA_RING2"; PAC_IMAGE="$PAC_IMAGE_RING2" ;;
  stone-prd-rh01|kflux-prd-rh03)
    CSV="$RING3_CSV"; CATSRC_SHA="$CATSRC_SHA_RING3"; PAC_IMAGE="$PAC_IMAGE_RING3" ;;
  *)
    CSV="$RING1_CSV"; CATSRC_SHA="$CATSRC_SHA_RING1"; PAC_IMAGE="$PAC_IMAGE_RING1" ;;
esac

# ── CatalogSource ──────────────────────────────────────────────────────────
if [[ "$*" == *"catalogsource custom-operators"* ]]; then
  if [[ "$*" == *"lastObservedState}{\"|\"}{.spec.image}"* ]]; then
    # Summary mode call
    echo "READY|registry.redhat.io/redhat/operator-index@${CATSRC_SHA}"
    exit 0
  fi
  echo "registry.redhat.io/redhat/operator-index@${CATSRC_SHA}|READY"
  exit 0
fi

# ── TektonConfig ───────────────────────────────────────────────────────────
if [[ "$*" == *"tektonconfig config"* ]]; then
  # TektonConfig replicas override check (events controller fallback)
  if [[ "$*" == *"tekton-events-controller.spec.replicas"* ]]; then
    echo "0"
    exit 0
  fi
  # Ready condition
  echo "True|AllDeploymentsReady|"
  exit 0
fi

# ── Subscription ───────────────────────────────────────────────────────────
if [[ "$*" == *"subscription openshift-pipelines-operator"* ]]; then
  echo "$CSV"
  exit 0
fi

# ── Pod health (openshift-pipelines) ───────────────────────────────────────
if [[ "$*" == *"pods"*"-n openshift-pipelines"* && "$*" != *"marketplace"* ]]; then
  if [[ "$CONTEXT" == "kflux-rhel-p01" ]]; then
    printf "Running\nRunning\nRunning\nCrashLoopBackOff\nRunning\nPending\nRunning\nRunning\n"
  else
    printf "Running\nRunning\nRunning\nRunning\nRunning\nSucceeded\nRunning\nRunning\n"
  fi
  exit 0
fi

# ── Events controller deployment ──────────────────────────────────────────
if [[ "$*" == *"deployment tekton-events-controller"* ]]; then
  if [[ "$*" == *"readyReplicas"*"replicas"*"memory"* ]]; then
    if [[ "$CONTEXT" == "kflux-ocp-p01" ]]; then
      echo "0|1|512Mi"
      exit 0
    fi
    echo "1|1|512Mi"
    exit 0
  fi
  # Summary mode — just replicas
  if [[ "$*" == *".status.replicas"* ]]; then
    echo "1"
    exit 0
  fi
  # Summary mode — readyReplicas
  if [[ "$*" == *".status.readyReplicas"* ]]; then
    if [[ "$CONTEXT" == "kflux-ocp-p01" ]]; then
      echo "0"
      exit 0
    fi
    echo "1"
    exit 0
  fi
fi

# ── PaC controller ─────────────────────────────────────────────────────────
if [[ "$*" == *"deployment pipelines-as-code-controller"* ]]; then
  echo "$PAC_IMAGE"
  exit 0
fi

# ── CronJob (--verify) ────────────────────────────────────────────────────
if [[ "$*" == *"cronjob tekton-resource-pruner"* ]]; then
  echo "2026-07-19T10:00:00Z|Complete|True"
  exit 0
fi

if [[ "$*" == *"cronjobs"*"-n openshift-pipelines"* ]]; then
  echo "cronjob/tekton-resource-pruner"
  exit 0
fi

# ── Jobs (--verify pruner) ─────────────────────────────────────────────────
if [[ "$*" == *"jobs"*"-n openshift-pipelines"* ]]; then
  echo "1"
  exit 0
fi

# ── Marketplace pods (--verify) ────────────────────────────────────────────
if [[ "$*" == *"pods"*"-n openshift-marketplace"* ]]; then
  printf "certified-operators-catalog-abc12|Running\ncommunity-operators-catalog-def34|Running\nredhat-marketplace-catalog-ghi56|Running\nredhat-operators-catalog-jkl78|Running\n"
  exit 0
fi

# Fallback for unmatched commands
echo "mock-oc: unhandled command: $*" >&2
exit 1
